<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Odoo 19 removed the props.data snapshot (built via each payment's
         now-removed export_for_printing()) that this used to read
         (props.data.paymentlines / line.name / line.is_foreign_currency_payment
         / props.formatCurrency). OrderReceipt now only takes `order` as a
         prop and exposes its own `paymentLines` getter and `formatCurrency`
         method reading directly off the live pos.order/pos.payment records
         (see point_of_sale.OrderReceipt's own paymentlines block). -->
    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('paymentlines')]" position="replace">
            <div
                class="paymentlines text-start pt-1 d-flex justify-content-between"
                t-foreach="paymentLines"
                t-as="line"
                t-key="line_index"
            >
                <t t-esc="line.payment_method_id.name" />
                <span class="pos-receipt-right-align font-monospace text-end">
                    <t t-if="line.isForeignCurrencyPayment()">
                        <div>
                            <t t-esc="formatReceiptPaymentForeignAmount(line)" />
                        </div>
                        <div>
                            (<t t-esc="formatCurrency(line.getAmount())" />)
                        </div>
                    </t>
                    <t t-else="">
                        <t t-esc="formatCurrency(line.getAmount())" />
                    </t>
                </span>
            </div>
        </xpath>
    </t>
</templates>
