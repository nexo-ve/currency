<?xml version="1.0" encoding="UTF-8"?>
<!--
    Odoo 19 renamed/rebuilt point_of_sale.OrderWidget as
    point_of_sale.OrderDisplay (@point_of_sale/app/components/order_display);
    the order-summary div this extension injects into kept the same class,
    so only the t-inherit target changed here.
-->
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.OrderDisplay" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'order-summary')]/*[1]" position="before">
            <t t-foreach="getAlternatePricelistTotals()" t-as="altTotal" t-key="altTotal.id">
                <div class="d-flex justify-content-between w-100 fs-6 text-muted currency_pos_alt_pricelist_total">
                    <span t-esc="altTotal.name"/>
                    <span
                        t-esc="formatAltTotal(altTotal.total, altTotal.currencyId)"
                        class="alt-pricelist-total"
                    />
                </div>
            </t>
        </xpath>
        <xpath expr="//div[contains(@class, 'order-summary')]" position="inside">
            <t t-if="shouldShowTotalConversion() and getConvertedTotal()">
                <div class="d-flex justify-content-between w-100 fs-6 text-muted">
                    <span>Total convertido</span>
                    <span t-esc="getConvertedTotal()" class="converted-total"/>
                </div>
            </t>
        </xpath>
    </t>
</templates>
